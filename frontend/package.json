    "@tanstack/react-query": "^5.90.7",
    "@tanstack/react-table": "^8.21.3",
    "antd": "^5.28.0",
    "axios": "^1.15.2",
    "color-convert": "^2.0.1",
    "convert-layout": "^0.11.1",
    "dayjs": "^1.11.19",
    "keycloak-js": "^26.2.1",
    "lottie-react": "^2.4.1",
    "motion": "^12.42.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-helmet": "^6.1.0",
